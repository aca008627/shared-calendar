rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function calendarDoc(calendarId) {
      return get(/databases/$(database)/documents/calendars/$(calendarId));
    }

    function isOwner(calendarId) {
      return signedIn()
        && calendarDoc(calendarId).data.ownerUid == request.auth.uid;
    }

    function isMember(calendarId) {
      return signedIn()
        && (
          calendarDoc(calendarId).data.ownerUid == request.auth.uid
          || email() in calendarDoc(calendarId).data.members
        );
    }

    // 每個帳號只能讀寫自己的雲端個人設定。
    match /users/{uid} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == uid;
    }

    match /calendars/{calendarId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == email()
        && email() in request.resource.data.members;

      // 管理員可直接讀取自己的行事曆，即使舊版 members 欄位缺漏。
      allow get: if signedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || email() in resource.data.members
        );

      allow list: if false;

      allow update: if isOwner(calendarId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail;

      allow delete: if isOwner(calendarId);

      match /events/{eventId} {
        allow read, create, update, delete: if isMember(calendarId);
      }
    }
  }
}
